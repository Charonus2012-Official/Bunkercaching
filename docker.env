# Required for the docker container
MARIADB_ROOT_PASSWORD=root_pwd

# App DB connection (must match above)
DB_USER=root
DB_PASSWORD=root_pwd
DB_HOST=db
DB_NAME=bunkercaching

# JWT
# JWT_SECRET=changeme_secret # JWT Token is exported while starting so it resets on restart
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# CORS
CORS_ALLOW_ORIGINS=http://localhost:8000
